# ============================================================
# ClassHub — Environment
# Salin ke .env.local lalu isi nilainya.
#
#   cp .env.example .env.local
#
# Kosong = aplikasi jalan MODE LOKAL (metadata di browser,
#          binary tidak disimpan).
# Diisi   = MODE CLOUD (Supabase Storage + database).
#
# PERINGATAN KEAMANAN
# Hanya ANON key yang boleh ada di sini (awalan NEXT_PUBLIC_).
# JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY di file ini —
# semua env NEXT_PUBLIC_ ikut ter-bundle ke browser.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
